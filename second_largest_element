Second largest element code-

int secondLargest(int arr[], int n){
int res = -1, largest = 0;

for(int i = 1;i<n;i++){
if(arr[i] > arr[largest])
{
res = largest;
largest = i;
}
elseif(arr[i]!=arr[largest]){
if(res == -1 || arr[i]>arr[res])
res = i;
}

}
return res;
}

